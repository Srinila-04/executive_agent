# =============================================================================
# Backend .gitignore
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions & Python runtime
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Databases
*.db
*.sqlite
*.sqlite3
manufacturing.db

# Logs
*.log
backend_err.log
backend_out.log

# Environment variables & secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json

# Scratch & Temporary
scratch/
scratch_*.py
tmp/
temp/
